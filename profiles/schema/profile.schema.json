{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZonDPI Profile Schema",
  "type": "object",
  "required": ["id", "name", "description", "target_engine", "arguments"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "target_engine": { "type": "string", "enum": ["GoodbyeDPI", "ByeDPI", "Native"] },
    "arguments": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
